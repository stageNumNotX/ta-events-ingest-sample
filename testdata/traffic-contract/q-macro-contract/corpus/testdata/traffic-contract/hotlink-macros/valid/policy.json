{
  "revisionId": "policy.hotlink-macros.1",
  "policyId": "ta-traffic-hotlink-macros-v1",
  "configurationRevision": "configuration.hotlink-macros.1",
  "contextRegistryVersion": 1,
  "contentRegistryVersion": 1,
  "scenarioKinds": [
    {
      "scenarioId": "redirect",
      "kind": "redirect"
    }
  ],
  "scenarioProgram": {
    "decisionScopeId": "scenario",
    "assignmentKey": "SUBJECT_ID",
    "salt": "hotlink-v1",
    "missingAssignmentChoiceId": "redirect",
    "rules": [
      {
        "ruleId": "ta-source-eq-ads",
        "when": {
          "op": "CONDITION",
          "field": "ta_source",
          "operator": "EQ",
          "value": "ads"
        },
        "branch": {
          "distributionKey": "scenario.rule.ta-source-eq-ads",
          "choiceIds": [
            "redirect"
          ]
        }
      },
      {
        "ruleId": "ta-source-in-partners",
        "when": {
          "op": "CONDITION",
          "field": "ta_source",
          "operator": "IN",
          "values": [
            "partner-a",
            "partner-b"
          ]
        },
        "branch": {
          "distributionKey": "scenario.rule.ta-source-in-partners",
          "choiceIds": [
            "redirect"
          ]
        }
      },
      {
        "ruleId": "ta-sub-eq-main",
        "when": {
          "op": "CONDITION",
          "field": "ta_sub",
          "operator": "EQ",
          "value": "main"
        },
        "branch": {
          "distributionKey": "scenario.rule.ta-sub-eq-main",
          "choiceIds": [
            "redirect"
          ]
        }
      },
      {
        "ruleId": "ta-sub-in-tags",
        "when": {
          "op": "CONDITION",
          "field": "ta_sub",
          "operator": "IN",
          "values": [
            "alpha",
            "beta"
          ]
        },
        "branch": {
          "distributionKey": "scenario.rule.ta-sub-in-tags",
          "choiceIds": [
            "redirect"
          ]
        }
      },
      {
        "ruleId": "hotlink-all-combo",
        "when": {
          "op": "ALL",
          "rules": [
            {
              "op": "CONDITION",
              "field": "ta_source",
              "operator": "EQ",
              "value": "combo-src"
            },
            {
              "op": "CONDITION",
              "field": "ta_sub",
              "operator": "EQ",
              "value": "combo-sub"
            }
          ]
        },
        "branch": {
          "distributionKey": "scenario.rule.hotlink-all-combo",
          "choiceIds": [
            "redirect"
          ]
        }
      },
      {
        "ruleId": "hotlink-any-src-or-sub",
        "when": {
          "op": "ANY",
          "rules": [
            {
              "op": "CONDITION",
              "field": "ta_source",
              "operator": "EQ",
              "value": "any-src"
            },
            {
              "op": "CONDITION",
              "field": "ta_sub",
              "operator": "EQ",
              "value": "any-sub"
            }
          ]
        },
        "branch": {
          "distributionKey": "scenario.rule.hotlink-any-src-or-sub",
          "choiceIds": [
            "redirect"
          ]
        }
      },
      {
        "ruleId": "hotlink-unblocked-source",
        "when": {
          "op": "ALL",
          "rules": [
            {
              "op": "CONDITION",
              "field": "ta_source",
              "operator": "EXISTS"
            },
            {
              "op": "NOT",
              "rule": {
                "op": "CONDITION",
                "field": "ta_source",
                "operator": "EQ",
                "value": "blocked"
              }
            }
          ]
        },
        "branch": {
          "distributionKey": "scenario.rule.hotlink-unblocked-source",
          "choiceIds": [
            "redirect"
          ]
        }
      },
      {
        "ruleId": "ta-source-exists",
        "when": {
          "op": "CONDITION",
          "field": "ta_source",
          "operator": "EXISTS"
        },
        "branch": {
          "distributionKey": "scenario.rule.ta-source-exists",
          "choiceIds": [
            "redirect"
          ]
        }
      },
      {
        "ruleId": "ta-sub-exists",
        "when": {
          "op": "CONDITION",
          "field": "ta_sub",
          "operator": "EXISTS"
        },
        "branch": {
          "distributionKey": "scenario.rule.ta-sub-exists",
          "choiceIds": [
            "redirect"
          ]
        }
      }
    ],
    "defaultBranch": {
      "distributionKey": "scenario.default",
      "choiceIds": [
        "redirect"
      ]
    }
  },
  "slotPrograms": [
    {
      "scenarioId": "redirect",
      "slotId": "target",
      "program": {
        "decisionScopeId": "redirect.target",
        "assignmentKey": "SUBJECT_ID",
        "salt": "target-v1",
        "missingAssignmentChoiceId": "disabled_target",
        "rules": [
          {
            "ruleId": "ta-source-eq-slot",
            "when": {
              "op": "CONDITION",
              "field": "ta_source",
              "operator": "EQ",
              "value": "slot-src"
            },
            "branch": {
              "distributionKey": "redirect.target.rule.ta-source-eq-slot",
              "choiceIds": [
                "disabled_target"
              ]
            }
          }
        ],
        "defaultBranch": {
          "distributionKey": "redirect.target.default",
          "choiceIds": [
            "disabled_target"
          ]
        }
      }
    }
  ]
}
