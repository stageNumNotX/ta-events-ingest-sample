{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://compiler-service.local/contracts/traffic/v1/defs.schema.json",
  "$defs": {
    "identity": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
    },
    "salt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "revisionIdentity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256Hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "safeInteger": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "safeNonNegativeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "safePositiveInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "basisPoint": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "rfc3339Utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "assignmentKey": {
      "type": "string",
      "enum": ["SUBJECT_ID", "REQUEST_ID"]
    },
    "choiceDomain": {
      "type": "string",
      "enum": ["SCENARIO", "VARIANT"]
    },
    "scenarioKind": {
      "type": "string",
      "enum": ["redirect", "render"]
    },
    "fixMode": {
      "type": "string",
      "enum": ["NONE", "EXACT", "EXCLUDE"]
    },
    "compileTarget": {
      "const": "traffic-runtime/v1"
    },
    "trafficJsonValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "$ref": "#/$defs/safeInteger" },
        { "type": "string" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/trafficJsonValue" }
        },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/trafficJsonValue" }
        }
      ]
    },
    "matcher": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "rules"],
          "properties": {
            "op": { "type": "string", "enum": ["ALL", "ANY"] },
            "rules": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "items": { "$ref": "#/$defs/matcher" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "rule"],
          "properties": {
            "op": { "const": "NOT" },
            "rule": { "$ref": "#/$defs/matcher" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "field", "operator"],
          "properties": {
            "op": { "const": "CONDITION" },
            "field": { "type": "string", "minLength": 1, "maxLength": 64 },
            "operator": { "const": "EXISTS" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "field", "operator", "value"],
          "properties": {
            "op": { "const": "CONDITION" },
            "field": { "type": "string", "minLength": 1, "maxLength": 64 },
            "operator": { "const": "EQ" },
            "value": {
              "oneOf": [
                { "type": "string" },
                { "type": "boolean" }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "field", "operator", "values"],
          "properties": {
            "op": { "const": "CONDITION" },
            "field": { "type": "string", "minLength": 1, "maxLength": 64 },
            "operator": { "const": "IN" },
            "values": {
              "type": "array",
              "minItems": 1,
              "maxItems": 200,
              "uniqueItems": true,
              "items": {
                "oneOf": [
                  { "type": "string" },
                  { "type": "boolean" }
                ]
              }
            }
          }
        }
      ]
    },
    "branchWire": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vectorIndex"],
      "properties": {
        "vectorIndex": { "$ref": "#/$defs/safeNonNegativeInteger" }
      }
    },
    "policyBranch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["distributionKey", "choiceIds"],
      "properties": {
        "distributionKey": { "$ref": "#/$defs/identity" },
        "choiceIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": { "$ref": "#/$defs/identity" }
        }
      }
    },
    "decisionRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleId", "when", "branch"],
      "properties": {
        "ruleId": { "$ref": "#/$defs/identity" },
        "when": { "$ref": "#/$defs/matcher" },
        "branch": { "$ref": "#/$defs/policyBranch" }
      }
    },
    "compiledDecisionRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleId", "when", "branch"],
      "properties": {
        "ruleId": { "$ref": "#/$defs/identity" },
        "when": { "$ref": "#/$defs/matcher" },
        "branch": { "$ref": "#/$defs/branchWire" }
      }
    },
    "decisionProgram": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decisionScopeId",
        "assignmentKey",
        "salt",
        "missingAssignmentChoiceId",
        "rules",
        "defaultBranch"
      ],
      "properties": {
        "decisionScopeId": { "$ref": "#/$defs/identity" },
        "assignmentKey": { "$ref": "#/$defs/assignmentKey" },
        "salt": { "$ref": "#/$defs/salt" },
        "missingAssignmentChoiceId": { "$ref": "#/$defs/identity" },
        "rules": {
          "type": "array",
          "maxItems": 128,
          "items": { "$ref": "#/$defs/decisionRule" }
        },
        "defaultBranch": { "$ref": "#/$defs/policyBranch" }
      }
    },
    "compiledDecisionProgram": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decisionScopeId",
        "assignmentKey",
        "salt",
        "missingAssignmentChoiceId",
        "rules",
        "defaultBranch"
      ],
      "properties": {
        "decisionScopeId": { "$ref": "#/$defs/identity" },
        "assignmentKey": { "$ref": "#/$defs/assignmentKey" },
        "salt": { "$ref": "#/$defs/salt" },
        "missingAssignmentChoiceId": { "$ref": "#/$defs/identity" },
        "rules": {
          "type": "array",
          "maxItems": 128,
          "items": { "$ref": "#/$defs/compiledDecisionRule" }
        },
        "defaultBranch": { "$ref": "#/$defs/branchWire" }
      }
    },
    "slotProgram": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenarioId", "slotId", "program"],
      "properties": {
        "scenarioId": { "$ref": "#/$defs/identity" },
        "slotId": { "$ref": "#/$defs/identity" },
        "program": { "$ref": "#/$defs/decisionProgram" }
      }
    },
    "compiledSlotProgram": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenarioId", "slotId", "typeId", "schemaVersion", "program"],
      "properties": {
        "scenarioId": { "$ref": "#/$defs/identity" },
        "slotId": { "$ref": "#/$defs/identity" },
        "typeId": { "$ref": "#/$defs/identity" },
        "schemaVersion": { "$ref": "#/$defs/safeInteger" },
        "program": { "$ref": "#/$defs/compiledDecisionProgram" }
      }
    },
    "scenarioWire": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "slotIds"],
      "properties": {
        "id": { "$ref": "#/$defs/identity" },
        "kind": { "$ref": "#/$defs/scenarioKind" },
        "slotIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/identity" }
        }
      }
    },
    "variantWire": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "typeId", "schemaVersion", "handlerVersion", "payload"],
      "properties": {
        "id": { "$ref": "#/$defs/identity" },
        "typeId": { "$ref": "#/$defs/identity" },
        "schemaVersion": { "$ref": "#/$defs/safeInteger" },
        "handlerVersion": { "$ref": "#/$defs/identity" },
        "payload": { "$ref": "#/$defs/trafficJsonValue" }
      }
    },
    "vectorLayoutWire": {
      "type": "object",
      "additionalProperties": false,
      "required": ["distributionKey", "choiceDomain", "choiceIds"],
      "properties": {
        "distributionKey": { "$ref": "#/$defs/identity" },
        "choiceDomain": { "$ref": "#/$defs/choiceDomain" },
        "choiceIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": { "$ref": "#/$defs/identity" }
        }
      }
    },
    "artifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "bytes"],
      "properties": {
        "sha256": { "$ref": "#/$defs/sha256Hex" },
        "bytes": { "$ref": "#/$defs/safePositiveInteger" }
      }
    },
    "sourceWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "watermark"],
      "properties": {
        "start": { "$ref": "#/$defs/rfc3339Utc" },
        "end": { "$ref": "#/$defs/rfc3339Utc" },
        "watermark": { "$ref": "#/$defs/rfc3339Utc" }
      }
    },
    "sourceTuple": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configurationRevision",
        "trafficPolicyRevision",
        "trafficSignalsRevision",
        "trafficBoundsRevision",
        "trafficFixRevision",
        "contextRegistryVersion",
        "contentRegistryVersion",
        "modelVersion",
        "sourceWindow"
      ],
      "properties": {
        "configurationRevision": { "$ref": "#/$defs/revisionIdentity" },
        "trafficPolicyRevision": { "$ref": "#/$defs/revisionIdentity" },
        "trafficSignalsRevision": { "$ref": "#/$defs/revisionIdentity" },
        "trafficBoundsRevision": { "$ref": "#/$defs/revisionIdentity" },
        "trafficFixRevision": { "$ref": "#/$defs/revisionIdentity" },
        "contextRegistryVersion": { "const": 1 },
        "contentRegistryVersion": { "enum": [1, 2] },
        "modelVersion": { "$ref": "#/$defs/revisionIdentity" },
        "sourceWindow": { "$ref": "#/$defs/sourceWindow" }
      }
    }
  }
}
