{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://compiler-service.local/contracts/traffic/v1/content-registry.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["registryVersion", "types"],
  "properties": {
    "registryVersion": { "enum": [1, 2] },
    "types": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["typeId", "schemaVersion", "handlerVersion", "payloadSchema"],
        "properties": {
          "typeId": { "$ref": "defs.schema.json#/$defs/identity" },
          "schemaVersion": { "$ref": "defs.schema.json#/$defs/safeInteger" },
          "handlerVersion": { "$ref": "defs.schema.json#/$defs/identity" },
          "payloadSchema": { "type": "object" }
        }
      }
    }
  }
}
