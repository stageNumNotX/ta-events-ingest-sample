{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://compiler-service.local/contracts/traffic/v1/traffic-policy.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "revisionId",
    "policyId",
    "configurationRevision",
    "contextRegistryVersion",
    "contentRegistryVersion",
    "scenarioKinds",
    "scenarioProgram",
    "slotPrograms"
  ],
  "properties": {
    "revisionId": { "$ref": "defs.schema.json#/$defs/revisionIdentity" },
    "policyId": { "$ref": "defs.schema.json#/$defs/identity" },
    "configurationRevision": { "$ref": "defs.schema.json#/$defs/revisionIdentity" },
    "contextRegistryVersion": { "const": 1 },
    "contentRegistryVersion": { "enum": [1, 2] },
    "scenarioKinds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scenarioId", "kind"],
        "properties": {
          "scenarioId": { "$ref": "defs.schema.json#/$defs/identity" },
          "kind": { "$ref": "defs.schema.json#/$defs/scenarioKind" }
        }
      }
    },
    "scenarioProgram": { "$ref": "defs.schema.json#/$defs/decisionProgram" },
    "slotPrograms": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": { "$ref": "defs.schema.json#/$defs/slotProgram" }
    }
  }
}
