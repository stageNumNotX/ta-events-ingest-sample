# Copy to .env and fill in local values. Never commit a real .env.

# log = print accepted events (no GCP). pubsub = Google Pub/Sub (needs ADC).
PUBLISHER=log
PROJECT_ID=local
PUBSUB_TOPIC=ta-events

# Required. Use unique non-production values locally.
EVENTS_INGEST_SECRET=dev-secret-change-me
IP_HASH_SALT=dev-salt-change-me

PORT=8080
MAX_BATCH_SIZE=20
